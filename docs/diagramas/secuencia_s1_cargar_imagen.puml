@startuml Secuencia_S1_CargarImagen
title Sprint 1 — HU-05 Cargar imagen con HU-06 Validar imagen
autonumber
actor Docente
boundary "Vista de actividad\n(React)" as UI
control "ImagenController" as IC
participant "ImageUploadService" as US
participant "ImageValidationService" as VS
entity "Imagen" as IM
database "Disco privado" as DISK
database "PostgreSQL" as DB

Docente -> UI : elige la fotografía del ejercicio
UI -> IC : POST /api/v1/actividades/{id}/imagen (multipart)
IC -> IC : UploadImagenRequest: JPG/PNG, máx. 5 MB
IC -> IC : Gate::authorize("update", actividad)
IC -> US : cargar(archivo, actividad)
US -> VS : validar(archivo)
VS -> VS : validarMimeReal()
VS -> VS : validarTamano()
VS -> VS : validarResolucion()
alt imagen válida
  US -> DISK : storeAs("graphilearn/imagenes", uuid.ext)
  US -> IM : create {id_actividad, ruta, formato, fecha_carga}
  IM -> DB : INSERT imagenes
  US --> IC : imagen
  IC --> UI : 201 "Imagen cargada y registrada exitosamente."
  UI --> Docente : confirma la carga
else formato, tamaño o resolución inválidos
  VS --> US : InvalidArgumentException(motivo)
  US --> IC : excepción
  IC --> UI : 422 {message: motivo}
  UI --> Docente : muestra qué condición falló
end
@enduml
