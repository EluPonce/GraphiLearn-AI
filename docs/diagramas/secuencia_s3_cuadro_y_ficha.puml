@startuml Secuencia_S3_CuadroYFicha
title Sprint 3 — HU-19/HU-20 Cuadro de evaluación y HU-13 Ficha del estudiante
autonumber
actor Docente
boundary "CoursesView /\nEvaluationGridView" as UI
boundary "StudentSheetView" as FI
control "EvaluationFlowController" as EC
entity "Evaluacion /\nFotoEjercicio" as EV
database "PostgreSQL" as DB

Docente -> UI : abre "Mis cursos"
UI -> EC : GET /api/v1/cursos
EC -> DB : cursos de la docente + Evaluación vigente + avance
EC --> UI : [{curso, trimestre_actual, nivel, estudiantes_completos}]
Docente -> UI : pulsa "Abrir evaluación" y elige el trimestre
UI -> EC : GET /api/v1/cursos/{id}/evaluaciones/{t}
EC -> EC : Gate::authorize("view", curso)
EC -> EV : Evaluación del curso y trimestre
alt existe la Evaluación
  EC -> EV : ensureSlots() (4 casillas por estudiante)
  EV -> DB : fotos y análisis de cada casilla
  EC --> UI : {evaluacion, ejercicios, estudiantes x 4 casillas}
  UI --> Docente : cuadro con chips S/ED/NA, Analizada, Foto lista y Sin foto
else no existe
  EC --> UI : {evaluacion: null}
  UI --> Docente : formulario "Crear evaluación" (nivel y tamaño de figura)
end
Docente -> UI : pulsa el nombre de un estudiante
UI -> FI : abrir ficha
FI -> EC : GET /api/v1/estudiantes/{id}/ficha
EC -> EC : Gate::authorize("view", estudiante)
EC -> DB : evaluaciones T1–T3, fotos y observaciones
EC --> FI : {trimestres, ejercicios x T1–T3 con valoración y observación, observaciones}
FI --> Docente : tabla por trimestre + "Las figuras son más chicas en cada trimestre..."
@enduml
