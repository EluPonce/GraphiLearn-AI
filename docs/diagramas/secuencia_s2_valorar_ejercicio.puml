@startuml Secuencia_S2_ValorarEjercicio
title Sprint 2 — HU-18 Valorar ejercicio (S, ED, NA con observación)
autonumber
actor Docente
boundary "EvaluationCaptureView\n(React)" as UI
control "CheckRole\n(role:docente)" as MW
control "EvaluationFlowController" as EC
entity "FotoEjercicio" as FE
entity "Observacion" as OB
database "PostgreSQL" as DB

Docente -> UI : paso 3: elige S, ED o NA y escribe la observación
UI -> MW : PUT /api/v1/evaluaciones/{e}/estudiantes/{s}/ejercicios/{ej}/valoracion
alt usuario con rol docente
  MW -> EC : rate(valoracion, observacion)
  EC -> EC : valida valoracion en {S, ED, NA};\nobservación de hasta 5000 caracteres
  EC -> EC : Gate::authorize("update", foto)\n(solo la docente del curso)
  alt la casilla tiene foto
    EC -> DB : BEGIN TRANSACTION
    EC -> FE : update {valoracion, valorado_por, valorado_en, estado: valorado}
    opt hay observación
      EC -> OB : create {id_estudiante, id_evaluacion, id_ejercicio, texto, autor}
    end
    EC -> DB : COMMIT
    EC --> UI : 200 {valoracion, valorado_por: {id, nombre}}
    UI --> Docente : "Guardado." + "Siguiente: ..."
  else la casilla no tiene foto
    EC --> UI : 422 "Sube una foto antes de guardar la valoración."
  end
else Dirección u otro rol
  MW --> UI : 403 (Dirección solo consulta)
end
@enduml
