@startuml Secuencia_S1_IniciarSesion
title Sprint 1 — HU-01 Iniciar sesión
autonumber
actor Usuario
boundary "LoginView\n(React)" as UI
control "AuthController" as AC
entity "User" as U
database "PostgreSQL" as DB

Usuario -> UI : ingresa correo y contraseña
UI -> AC : POST /api/v1/auth/login {correo, password}
note right of AC : Límite: 5 intentos por minuto (throttle:5,1)
AC -> U : where(correo)->first()
U -> DB : SELECT * FROM users WHERE correo = ?
DB --> U : usuario o vacío
U --> AC : usuario
alt credenciales válidas y usuario activo
  AC -> AC : Hash::check(password)
  AC -> U : createToken("auth_token")
  U -> DB : INSERT personal_access_tokens
  AC --> UI : 200 {access_token, token_type: Bearer, user}
  UI -> UI : guarda el token en sessionStorage
  UI --> Usuario : muestra "Mis cursos"
else credenciales incorrectas o usuario inactivo
  AC --> UI : 422 "Las credenciales proporcionadas son incorrectas."
  UI --> Usuario : muestra el error
end
@enduml
