@startuml Clases_Sprint2
!pragma layout smetana
title Sprint 2 — Diagrama de clases (evaluación por trimestre y análisis)
hide methods
skinparam classAttributeIconSize 0

class Institucion {
  - id : Integer
  - nombre : String
}
class Usuario {
  - id : Integer
  - nombre : String
  - correo : String
  - contrasena : String
  - rol : String
  - activo : Boolean
}
class Curso {
  - id : Integer
  - nombre : String
  - nivel : String
  - gestion : String
  - activo : Boolean
}
class Estudiante {
  - id : Integer
  - nombre : String
  - fecha_nacimiento : Date
}
class Ejercicio {
  - id : Integer
  - nombre : String
  - tipo_trazo : String
  - descripcion : String
  - activo : Boolean
}
class Evaluacion {
  - id : Integer
  - trimestre : Integer
  - nivel : Integer
  - tamano_figura_mm : Decimal
  - fecha : Date
}
class FotoEjercicio {
  - id : Integer
  - estado : String
  - ruta_imagen : String
  - valoracion : String
  - valorado_en : DateTime
  - fecha : Date
}
class Analisis {
  - id : Integer
  - tipo_trazo : String
  - caracteristicas : JSON
  - indicadores : JSON
  - sugerencia : String
  - rutas_etapas : JSON
  - estado : String
  - detalles_computacionales : JSON
}
class Observacion {
  - id : Integer
  - texto : String
  - fecha : DateTime
}
class VersionModelo {
  - id : Integer
  - nombre : String
  - version : String
  - algoritmo : String
  - ruta_archivo : String
  - metricas : JSON
  - activo : Boolean
}

Institucion "1" -- "0..*" Usuario : pertenece
Institucion "1" -- "0..*" Curso : tiene
Usuario "0..1" -- "0..*" Curso : imparte
Curso "1" -- "0..*" Estudiante : tiene
Curso "1" -- "0..3" Evaluacion : se evalúa
Evaluacion "1" -- "0..*" FotoEjercicio : contiene
Estudiante "1" -- "0..*" FotoEjercicio : realiza
Ejercicio "1" -- "0..*" FotoEjercicio : corresponde
Usuario "0..1" -- "0..*" FotoEjercicio : valora
FotoEjercicio "1" -- "0..1" Analisis : genera
VersionModelo "0..1" -- "0..*" Analisis : produce
Estudiante "1" -- "0..*" Observacion : sobre
Evaluacion "0..1" -- "0..*" Observacion : en
Ejercicio "0..1" -- "0..*" Observacion : de
Usuario "0..1" -- "0..*" Observacion : escribe
@enduml
