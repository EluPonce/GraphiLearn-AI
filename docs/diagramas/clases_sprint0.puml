@startuml Clases_Sprint0
!pragma layout smetana
title Sprint 0 — Esbozo inicial del modelo de datos
hide methods
skinparam classAttributeIconSize 0

class Institucion {
  - nombre
}
class Usuario {
  - nombre
  - correo
  - rol
}
class Curso {
  - nombre
  - nivel
  - gestion
}
class Estudiante {
  - nombre
  - fecha_nacimiento
}
class Ejercicio {
  - nombre
  - tipo_trazo
}
class Actividad {
  - fecha
}
class Imagen {
  - ruta
}
class ResultadoAnalisis {
  - caracteristicas
  - indicadores
  - clasificacion
}
class VersionModelo {
  - nombre
  - version
}

Institucion "1" -- "0..*" Usuario : pertenece
Institucion "1" -- "0..*" Curso : tiene
Usuario "0..1" -- "0..*" Curso : imparte
Curso "1" -- "0..*" Estudiante : tiene
Estudiante "1" -- "0..*" Actividad : realiza
Ejercicio "1" -- "0..*" Actividad : corresponde
Actividad "1" -- "0..1" Imagen : tiene
Actividad "1" -- "0..1" ResultadoAnalisis : genera
VersionModelo "0..1" -- "0..*" ResultadoAnalisis : produce
@enduml
