@startuml Clases_Sprint1
!pragma layout smetana
title Sprint 1 — Diagrama de clases
hide methods
skinparam classAttributeIconSize 0

class Institucion {
  - id : Integer
  - nombre : String
  - direccion : String
}
class Usuario {
  - id : Integer
  - nombre : String
  - correo : String
  - contrasena : String
  - rol : Rol
}
class Curso {
  - id : Integer
  - nombre : String
  - nivel : String
  - gestion : String
}
class Estudiante {
  - id : Integer
  - nombre : String
  - fecha_nacimiento : Date
}
class Ejercicio {
  - id : Integer
  - nombre : String
  - tipo_trazo : TipoTrazo
  - descripcion : String
  - activo : Boolean
}
class Actividad {
  - id : Integer
  - fecha : Date
  - estado : String
}
class Imagen {
  - id : Integer
  - ruta : String
  - formato : String
  - fecha_carga : DateTime
}
enum Rol {
  administrador
  docente
}
enum TipoTrazo {
  linea
  circulo
  espiral
  zigzag
}

Institucion "1" -- "0..*" Usuario : pertenece
Institucion "1" -- "0..*" Curso : tiene
Usuario "0..1" -- "0..*" Curso : imparte
Curso "1" -- "0..*" Estudiante : tiene
Estudiante "1" -- "0..*" Actividad : realiza
Ejercicio "1" -- "0..*" Actividad : corresponde
Actividad "1" -- "0..1" Imagen : tiene
@enduml
